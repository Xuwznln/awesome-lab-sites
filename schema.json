{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Xuwznln/awesome-lab-sites/main/schema.json",
  "title": "awesome-lab-sites index",
  "description": "Uni-Lab-OS 前端站点索引。微后端导航页（unilab 管理端口的 /）和 OpenLab 的站点目录在浏览器里直接读取 sites[]，每条是一个可连接微后端的前端站点地址。",
  "type": "object",
  "required": ["schema", "sites"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "awesome-lab-sites/v1" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "updated_at": { "type": "string", "description": "YYYY-MM-DD" },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/definitions/site" }
    }
  },
  "definitions": {
    "site": {
      "type": "object",
      "required": ["id", "name", "url", "description"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "索引内唯一的 slug，前端用它去重与记忆选择。"
        },
        "name": { "type": "string", "minLength": 1, "description": "展示名。" },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "站点入口地址（必须 https）。可带 query（如 ?theme=organic）让站点以某个学科主题进入。"
        },
        "description": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri", "description": "源码 / 发布仓库。" },
        "theme": {
          "type": "string",
          "description": "站点进入时的学科主题 id（OpenLab 内置：general / organic / biology / materials；fork 可自定义）。"
        },
        "protocol": {
          "type": "string",
          "description": "站点面向的微后端协议，当前为 runtime.v1。",
          "default": "runtime.v1"
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "official": { "type": "boolean", "description": "缺省 true（本索引即官方目录）。社区维护的站点标 false。" },
        "maintainers": { "type": "array", "items": { "type": "string" } },
        "min_unilabos": { "type": "string", "description": "要求的最低 unilabos 版本（PEP 440），仅展示用。" }
      }
    }
  }
}
